--- a/sys/vfs/hammer2/hammer2_ioctl.c
+++ b/sys/vfs/hammer2/hammer2_ioctl.c
@@ -636,8 +636,19 @@
 		return(EINVAL);
 	pfs->name[sizeof(pfs->name) - 1] = 0;	/* ensure 0-termination */
 
-	if (hammer2_ioctl_pfs_lookup(ip, pfs) == 0)
+	/*
+	 * hammer2_pfsalloc() below walks and inserts into hammer2_pfslist
+	 * and adjusts mount_count, which mount and unmount change under
+	 * hammer2_mntlk; an unmount that tears down the last device of the
+	 * cluster in between frees the pmp the walk found.  The lookup also
+	 * shows the name free only while no other create can insert it.
+	 * Take the lock before the transaction, as pfs_delete does.
+	 */
+	lockmgr(&hammer2_mntlk, LK_EXCLUSIVE);
+	if (hammer2_ioctl_pfs_lookup(ip, pfs) == 0) {
+		lockmgr(&hammer2_mntlk, LK_RELEASE);
 		return(EEXIST);
+	}
 
 	hammer2_trans_init(hmp->spmp, HAMMER2_TRANS_ISFLUSH);
 	mtid = hammer2_trans_sub(hmp->spmp);
@@ -702,6 +713,7 @@
 	}
 	hammer2_trans_done(hmp->spmp, HAMMER2_TRANS_ISFLUSH |
 				      HAMMER2_TRANS_SIDEQ);
+	lockmgr(&hammer2_mntlk, LK_RELEASE);
 
 	return (error);
 }
