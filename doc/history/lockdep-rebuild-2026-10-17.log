#### kernel-rebuild.sh
#!/bin/sh
# Rebuild the guest's debug kernel of record with a larger lockdep
# dependency table, 2026-10-17.  Host side only; the install is a second
# step.  Never run while a module build uses the same tree.
set -eu
T=$HOME/kernels/linux-7.3-rc5
STAGE=$HOME/kernels/stage-7.3-rc5
cd "$T"
pgrep -af "make" | grep -v pgrep && { echo "a make is running"; exit 2; }
echo "== before: $(grep -E '^CONFIG_LOCKDEP_BITS|^CONFIG_LOCKDEP_STACK_TRACE_BITS' .config | tr '\n' ' ')"
cp .config /tmp/h2-cocci/config-rc5-before
scripts/config --set-val LOCKDEP_BITS 17 --set-val LOCKDEP_STACK_TRACE_BITS 20
make olddefconfig >/dev/null
echo "== after:  $(grep -E '^CONFIG_LOCKDEP_BITS|^CONFIG_LOCKDEP_STACK_TRACE_BITS' .config | tr '\n' ' ')"
diff /tmp/h2-cocci/config-rc5-before .config || true
s=$(date +%s)
make -j20 > /tmp/h2-cocci/kernel-build.log 2>&1 || { echo "BUILD FAILED, see /tmp/h2-cocci/kernel-build.log"; tail -20 /tmp/h2-cocci/kernel-build.log; exit 1; }
echo "== built in $(( $(date +%s) - s )) s: $(grep -c . /tmp/h2-cocci/kernel-build.log) log lines, warnings $(grep -c 'warning:' /tmp/h2-cocci/kernel-build.log)"
rm -rf "$STAGE/lib/modules/7.3.0-rc5"
make INSTALL_MOD_PATH="$STAGE" modules_install > /tmp/h2-cocci/modules-install.log 2>&1
tar -C "$STAGE" -cf "$HOME/kernels/modules-7.3.0-rc5-lockdep17.tar" lib
ls -la arch/x86/boot/bzImage "$HOME/kernels/modules-7.3.0-rc5-lockdep17.tar"
echo "== kernel rebuild done $(date +%T)"

#### kernel-install.sh
#!/bin/sh
# Install the rebuilt h2debug-rc5 kernel on the guest and cycle it.
# The version string is unchanged, so the modules directory is replaced,
# the initramfs regenerated from it, and grub re-pinned; sync before the
# destroy, since a destroy a few seconds after grub-mkconfig loses the
# write (switching-the-guest-kernel).
set -eu
SSH=root@192.168.122.16
V="virsh --connect qemu:///system"
T=$HOME/kernels/linux-7.3-rc5
TAR=$HOME/kernels/modules-7.3.0-rc5-lockdep17.tar
ssh $SSH 'uname -r; grep -E "direct dependencies" /proc/lockdep_stats'
scp -q "$T/arch/x86/boot/bzImage" $SSH:/boot/vmlinuz-linux-h2debug-rc5
scp -q "$TAR" $SSH:/tmp/modules.tar
ssh $SSH 'set -e
rm -rf /lib/modules/7.3.0-rc5
tar -C / -xf /tmp/modules.tar && rm /tmp/modules.tar
ls /lib/modules/7.3.0-rc5/kernel >/dev/null
mkinitcpio -p linux-h2debug-rc5 2>&1 | grep -E "Image generation|ERROR|WARNING" || true
sh /root/setkernel.sh h2debug-rc5
sync; sync'
echo "== installed, cycling $(date +%T)"
$V destroy artix-s6-kde
sleep 3
$V start artix-s6-kde
i=0; while ! ssh -o ConnectTimeout=3 -o BatchMode=yes $SSH true 2>/dev/null; do sleep 3; i=$((i+1)); [ $i -gt 100 ] && { echo "no ssh after 300 s"; exit 1; }; done
echo "== up after ~$((i*3)) s"
ssh $SSH 'uname -r; uname -v; grep -E "lock-classes|direct dependencies|stack-trace entries" /proc/lockdep_stats; cat /proc/sys/kernel/debug_locks 2>/dev/null || echo "debug_locks: no procfs knob"; ls /dev/disk/by-id/ | grep -c virtio || true'
echo "== done $(date +%T)"
