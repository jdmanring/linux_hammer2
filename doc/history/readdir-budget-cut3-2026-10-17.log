#### probe6.sh
#!/bin/sh
# Guest-side probe, 2026-10-17: directory listing and seeking before and
# after the readdir budget, module b64ec28 (/tmp/h2-old.ko) against the
# working tree (/tmp/h2-new3.ko), and the getdents sweep at five buffer
# sizes on the same directories.  Output is the record.
set -u
T=$(readlink -f /dev/disk/by-id/virtio-h2xtest)
S=$(readlink -f /dev/disk/by-id/virtio-h2xscratch)
[ -b "$T" ] && [ -b "$S" ] && [ "$T" != "$S" ] || { echo "SETUP the volumes are not both present"; exit 0; }
D=/mnt/h2xscratch
TR=/root/h2xfstests/src/t_readdir_3
GD=/tmp/h2getdents; chmod 755 $GD
now() { date +%s.%N; }
el() { awk "BEGIN { printf \"%.3f\", $2 - $1 }"; }
listing() {
	k=0; while [ $k -lt 3 ]; do
		s=$(now); c=$(ls -f $D/big | wc -l); e=$(now)
		echo "   ls -f big: $c entries in $(el "$s" "$e") s"; k=$((k+1))
	done
	echo "   big sorted listing md5 $(ls -f $D/big | sort | md5sum | cut -c1-16)"
	for n in 14 15 16 17 30 31 32 33; do
		printf "   b%s: %s entries, %s duplicated\n" "$n" "$(ls -f $D/b$n | wc -l)" "$(ls -f $D/b$n | sort | uniq -d | wc -l)"
	done
}
sweep() {
	for d in big b15 b16 b17 b33; do
		echo "   sweep $d:"; $GD $D/$d sweep 2>&1 | sed "s/^/      /"; echo "      exit $?"
	done
}
seek500() {
	rm -rf "$D/$1"; mkdir "$D/$1"
	perf stat -e context-switches,task-clock -- "$TR" "$D/$1" 500 7 2>&1 | grep -E "passed|task-clock|elapsed" | sed "s/^/   /"
}
dmesg -C
echo "== uptime $(cut -d' ' -f1 /proc/uptime) s, $(uname -r)"
insmod /tmp/h2-old.ko || { echo "SETUP insmod old failed"; exit 0; }
mkdir -p /mnt/h2xtest $D
mount -t hammer2 "$T" /mnt/h2xtest && mount -t hammer2 "$S" $D || { echo "SETUP mount"; exit 0; }
for n in 14 15 16 17 30 31 32 33; do
	mkdir $D/b$n; i=0; while [ $i -lt $n ]; do : > $D/b$n/f$i; i=$((i+1)); done
done
mkdir $D/big; i=0; s=$(now); while [ $i -lt 4000 ]; do : > $D/big/f$i; i=$((i+1)); done; e=$(now)
sync
echo "== 4000 creates in $(el "$s" "$e") s"
echo "== old module b64ec28: listing"; listing
echo "== old module: getdents sweep"; sweep
echo "== old module: perf stat t_readdir_3 n=500 seed 7"; seek500 o500
umount $D /mnt/h2xtest && rmmod hammer2 || { echo "SETUP old unload"; exit 0; }
insmod /tmp/h2-new3.ko || { echo "SETUP insmod new failed"; exit 0; }
mount -t hammer2 "$T" /mnt/h2xtest && mount -t hammer2 "$S" $D || { echo "SETUP remount"; exit 0; }
echo "== new module: listing"; listing
echo "== new module: getdents sweep"; sweep
echo "== new module: perf stat t_readdir_3 n=500 seed 7"; seek500 n500
echo "== new module: t_readdir_3 n=4000 seed 7, generic/676's workload"
rm -rf $D/n4000; mkdir $D/n4000
s=$(now); "$TR" $D/n4000 4000 7 2>&1 | sed "s/^/   /"; echo "   exit $?"; e=$(now)
echo "   n=4000 in $(el "$s" "$e") s"
echo "== new module: sweep on the 4000-entry directory t_readdir_3 made, names 8 to 70 bytes"; $GD $D/n4000 sweep 2>&1 | sed "s/^/   /"; echo "   exit $?"
echo "== lockdep"; grep -E "lock-classes|direct dependencies|stack-trace entries" /proc/lockdep_stats | sed "s/^/   /"
umount $D /mnt/h2xtest
dmesg | grep "after unmount" | tail -2 | sed "s/^/   /"
rmmod hammer2; echo "rmmod exit $?"
echo "log: bug $(dmesg | grep -c "kernel BUG") oops $(dmesg | grep -ci oops) warn $(dmesg | grep -c "WARNING:") lockdep $(dmesg | grep -ci "lockdep\|possible.*deadlock\|too low")"
