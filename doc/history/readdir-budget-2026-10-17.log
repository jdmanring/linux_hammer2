#!/bin/sh
# Guest-side probe, 2026-10-17: the cost of one seek-and-read-one-entry
# against directory size, unflushed and flushed, on the budgeted module,
# and where a call spends its time at 4000 entries.
set -u
T=$(readlink -f /dev/disk/by-id/virtio-h2xtest)
S=$(readlink -f /dev/disk/by-id/virtio-h2xscratch)
[ -b "$T" ] && [ -b "$S" ] && [ "$T" != "$S" ] || { echo "SETUP the volumes are not both present"; exit 0; }
D=/mnt/h2xscratch
SC=/tmp/seekcost; chmod 755 $SC
mk() { mkdir "$1"; i=0; while [ $i -lt "$2" ]; do : > "$1/f$i"; i=$((i+1)); done; }
dmesg -C
insmod /tmp/h2-new2.ko || { echo "SETUP insmod failed"; exit 0; }
mkdir -p /mnt/h2xtest $D
mount -t hammer2 "$T" /mnt/h2xtest && mount -t hammer2 "$S" $D || { echo "SETUP mount"; exit 0; }
echo "== slab names with h2 or hammer"; grep -iE "h2|hammer" /proc/slabinfo | awk '{print "   " $1, "active", $2}'
for n in 500 1000 2000 4000; do
	mk $D/u$n $n
	echo "== n=$n unflushed:  $($SC $D/u$n 1000 7)"
	sync; sleep 1
	echo "== n=$n after sync: $($SC $D/u$n 1000 7)"
	echo "   chains allocated now: $(grep -iE "h2chain|hammer2_chain" /proc/slabinfo | awk '{print $2}' | head -1)"
done
echo "== n=4000 after sync, 3000 calls, perf: self >= 2%"
perf record -q -g -o /tmp/perf5.data -- $SC $D/u4000 3000 7
perf report -i /tmp/perf5.data --stdio --no-children -g none --percent-limit 2 2>/dev/null | grep -v "^$" | grep -v "^#" | head -30 | sed "s/^/   /"
echo "== children >= 4%"
perf report -i /tmp/perf5.data --stdio --children -g none --percent-limit 4 2>/dev/null | grep -v "^$" | grep -v "^#" | head -45 | sed "s/^/   /"
echo "== n=4000 fresh unflushed directory, 1000 calls, perf: self >= 2%"
mk $D/v4000 4000
perf record -q -g -o /tmp/perf5b.data -- $SC $D/v4000 1000 7
perf report -i /tmp/perf5b.data --stdio --no-children -g none --percent-limit 2 2>/dev/null | grep -v "^$" | grep -v "^#" | head -30 | sed "s/^/   /"
echo "== hammer2 self symbols in the flushed profile"
perf report -i /tmp/perf5.data --stdio --no-children -g none --percent-limit 0.3 2>/dev/null | grep "hammer2_" | head -25 | sed "s/^/   /"
umount $D /mnt/h2xtest
rmmod hammer2; echo "rmmod exit $?"
echo "log: bug $(dmesg | grep -c "kernel BUG") oops $(dmesg | grep -ci oops) warn $(dmesg | grep -c "WARNING:")"

#### seekcost.c
/*
 * seekcost <dir> <calls> <seed>: read every position once with a 32 KiB
 * buffer, then <calls> times seek to a random recorded position and read
 * one entry into a 280-byte buffer.  Prints the mean microseconds per
 * seek-and-read.  Instrumentation for the 2026-10-17 readdir reading.
 */
#define _GNU_SOURCE
#include <fcntl.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>
#include <sys/syscall.h>

struct linux_dirent64 {
	unsigned long long d_ino;
	long long d_off;
	unsigned short d_reclen;
	unsigned char d_type;
	char d_name[];
};

static double
now(void)
{
	struct timespec ts;

	clock_gettime(CLOCK_MONOTONIC, &ts);
	return (ts.tv_sec + ts.tv_nsec / 1e9);
}

int
main(int argc, char **argv)
{
	static char big[32768], small[280];
	long long *pos;
	int fd, n, npos = 0, cap = 1 << 16, calls, i, fails = 0;
	double t0, t1;

	if (argc != 4)
		return (2);
	calls = atoi(argv[2]);
	srandom(atol(argv[3]));
	pos = calloc(cap, sizeof(*pos));
	fd = open(argv[1], O_RDONLY | O_DIRECTORY);
	if (fd < 0 || !pos) {
		perror("open");
		return (2);
	}
	/* The position before each entry is the d_off of the one before. */
	pos[npos++] = 0;
	while ((n = syscall(SYS_getdents64, fd, big, sizeof(big))) > 0) {
		int off = 0;
		while (off < n) {
			struct linux_dirent64 *d = (void *)(big + off);
			if (npos < cap)
				pos[npos++] = d->d_off;
			off += d->d_reclen;
		}
	}
	npos--;	/* the last d_off is the end */
	t0 = now();
	for (i = 0; i < calls; i++) {
		long long p = pos[random() % npos];
		if (lseek(fd, p, SEEK_SET) < 0 ||
		    syscall(SYS_getdents64, fd, small, sizeof(small)) <= 0)
			fails++;
	}
	t1 = now();
	printf("positions=%d calls=%d fails=%d us_per_call=%.0f\n", npos,
	    calls, fails, (t1 - t0) * 1e6 / calls);
	return (fails ? 1 : 0);
}

#### drive.sh
#!/bin/sh
# Host driver: drive.sh <probe.sh> <ko>...  Two 3G sparse volumes in the
# fixture dir, attached as the xfstests runner attaches them, removed
# after; each ko lands on the guest as /tmp/<basename>.
set -u
cd /home/james/Projects/linux_hammer2 || exit 2
G=artix-s6-kde; SSH=root@192.168.122.16
V="virsh --connect qemu:///system"
NEWFS=$HOME/Projects/hammer2-utils-upstream/target/release/newfs_hammer2
FIX=$HOME/Projects/linux_hammer2-data/fixtures
TV=$FIX/xfstests-test.img; SV=$FIX/xfstests-scratch.img
probe=$1; shift
detach() { for t in vdx vdy; do $V detach-disk $G $t --live >/dev/null 2>&1; $V detach-disk $G $t --config >/dev/null 2>&1; done; }
trap 'detach; rm -f "$TV" "$SV"' EXIT
for img in "$TV" "$SV"; do rm -f "$img"; truncate -s 3G "$img"; "$NEWFS" "$img" >/dev/null 2>&1 || { echo "newfs failed $img"; exit 2; }; done
detach
$V attach-disk $G "$TV" vdx --targetbus virtio --serial h2xtest >/dev/null 2>&1 &&
$V attach-disk $G "$SV" vdy --targetbus virtio --serial h2xscratch >/dev/null 2>&1 || { echo "attach failed"; exit 2; }
for ko in "$@"; do scp -q "$ko" "$SSH:/tmp/$(basename "$ko")" || { echo "copy failed $ko"; exit 2; }; done
scp -q "$probe" $SSH:/tmp/probe.sh || { echo "copy failed"; exit 2; }
ssh $SSH 'i=0; while [ ! -e /dev/disk/by-id/virtio-h2xscratch ] && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done; udevadm settle -t 10; sh /tmp/probe.sh' 2>&1
echo "== driver done $(date +%T), tree $(git rev-parse --short HEAD)$(git diff --quiet || echo +dirty)"
