#!/bin/sh
# Guest-side probe, 2026-10-17: where a one-entry getdents spends its time
# on the bounded module, at 1000 and 3000 entries.
set -u
T=$(readlink -f /dev/disk/by-id/virtio-h2xtest)
S=$(readlink -f /dev/disk/by-id/virtio-h2xscratch)
[ -b "$T" ] && [ -b "$S" ] && [ "$T" != "$S" ] || { echo "SETUP the volumes are not both present"; exit 0; }
D=/mnt/h2xscratch
TR=/root/h2xfstests/src/t_readdir_3
dmesg -C
insmod /tmp/h2-new.ko || { echo "SETUP insmod failed"; exit 0; }
mkdir -p /mnt/h2xtest $D
mount -t hammer2 "$T" /mnt/h2xtest && mount -t hammer2 "$S" $D || { echo "SETUP mount"; exit 0; }
echo "== slab: hammer2 chains before"; grep -E "hammer2_chain|hammer2_xop" /proc/slabinfo | awk '{print "   " $1, "active", $2, "num", $3}'
echo "== perf record t_readdir_3 n=1000"
rm -rf $D/p1000; mkdir $D/p1000
perf record -q -g -o /tmp/perf3.data -- "$TR" $D/p1000 1000 7 >/dev/null 2>&1
echo "== slab: hammer2 chains after n=1000 (directory still mounted)"; grep -E "hammer2_chain|hammer2_xop" /proc/slabinfo | awk '{print "   " $1, "active", $2, "num", $3}'
echo "== children, top symbols >= 2%"
perf report -i /tmp/perf3.data --stdio --children -g none --percent-limit 2 2>/dev/null | grep -v "^$" | grep -v "^#" | head -60 | sed "s/^/   /"
echo "== self, top symbols >= 1.5%"
perf report -i /tmp/perf3.data --stdio --no-children -g none --percent-limit 1.5 2>/dev/null | grep -v "^$" | grep -v "^#" | head -40 | sed "s/^/   /"
echo "== callers of the top self symbol, caller view"
top=$(perf report -i /tmp/perf3.data --stdio --no-children -g none --percent-limit 1.5 2>/dev/null | grep -v "^#" | grep -v "^$" | head -1 | awk '{print $NF}')
echo "   top self symbol: $top"
perf report -i /tmp/perf3.data --stdio --no-children -G -S "$top" --percent-limit 2 2>/dev/null | grep -v "^$" | grep -v "^#" | head -70 | sed "s/^/   /"
echo "== timing n=3000 one phase: create, then one seek pass timed by strace -c? no: time the whole"
rm -rf $D/p3000; mkdir $D/p3000
s=$(date +%s.%N); "$TR" $D/p3000 3000 7 >/dev/null 2>&1; e=$(date +%s.%N)
echo "   n=3000 in $(awk "BEGIN { printf \"%.1f\", $e - $s }") s"
echo "== slab after n=3000"; grep -E "hammer2_chain|hammer2_xop" /proc/slabinfo | awk '{print "   " $1, "active", $2, "num", $3}'
umount $D /mnt/h2xtest
rmmod hammer2; echo "rmmod exit $?"
echo "log: bug $(dmesg | grep -c "kernel BUG") oops $(dmesg | grep -ci oops) warn $(dmesg | grep -c "WARNING:")"

