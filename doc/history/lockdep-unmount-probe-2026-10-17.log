== probe1.sh
#!/bin/sh
# Guest-side probe, 2026-10-17: lockdep share, unmount-counter control,
# directory-seek scaling.  Output is the record.
set -u
T=$(readlink -f /dev/disk/by-id/virtio-h2xtest)
S=$(readlink -f /dev/disk/by-id/virtio-h2xscratch)
[ -b "$T" ] && [ -b "$S" ] && [ "$T" != "$S" ] || { echo "SETUP the volumes are not both present"; exit 0; }
ld() { grep -E "lock-classes|dynamic-keys|direct dependencies|dependency chains:" /proc/lockdep_stats | sed "s/^/   /"; }
dmesg -C
echo "== uptime $(cut -d' ' -f1 /proc/uptime) s, $(uname -r), debug_locks $(cat /proc/sys/kernel/debug_locks 2>/dev/null || echo ?)"
echo "== lockdep before insmod"; ld
insmod /tmp/h2.ko || { echo "SETUP insmod failed"; exit 0; }
echo "== lockdep after insmod"; ld
mkdir -p /mnt/h2xtest /mnt/h2xscratch
mount -t hammer2 "$T" /mnt/h2xtest || { echo "SETUP mount test"; exit 0; }
mount -t hammer2 "$S" /mnt/h2xscratch || { echo "SETUP mount scratch"; exit 0; }
echo "== lockdep after two mounts"; ld
echo "== control: a clean unmount of scratch while test stays mounted"
umount /mnt/h2xscratch && dmesg | grep "after unmount" | tail -1
mount -t hammer2 "$S" /mnt/h2xscratch || { echo "SETUP remount scratch"; exit 0; }
TR=/root/h2xfstests/src/t_readdir_3
for n in 250 500 1000; do
	rm -rf "/mnt/h2xscratch/d$n"; mkdir "/mnt/h2xscratch/d$n"
	echo "== t_readdir_3 n=$n seed 7"
	/usr/bin/time -f "   n=$n wall %e s user %U s sys %S s" "$TR" "/mnt/h2xscratch/d$n" "$n" 7 2>&1 | tail -4 | sed "s/^/   /"
done
echo "== perf stat t_readdir_3 n=500"
rm -rf /mnt/h2xscratch/ds; mkdir /mnt/h2xscratch/ds
perf stat -e context-switches,cpu-migrations,task-clock -- "$TR" /mnt/h2xscratch/ds 500 7 2>&1 | grep -E "context-switches|task-clock|elapsed|sys|user" | sed "s/^/   /"
echo "== perf record t_readdir_3 n=1000, no-children, >=1.5%"
rm -rf /mnt/h2xscratch/dp; mkdir /mnt/h2xscratch/dp
perf record -q -g -o /tmp/perf.data -- "$TR" /mnt/h2xscratch/dp 1000 7 >/dev/null 2>&1
perf report -i /tmp/perf.data --stdio --no-children --percent-limit 1.5 2>/dev/null | grep -v "^$" | grep -v "^#" | head -90 | sed "s/^/   /"
echo "== perf report, children, top symbols"
perf report -i /tmp/perf.data --stdio --children -g none --percent-limit 3 2>/dev/null | grep -v "^$" | grep -v "^#" | head -40 | sed "s/^/   /"
echo "== lockdep after the workload"; ld
echo "== hammer2 lock classes in /proc/lockdep: class count, direct deps from them, direct deps into them from other classes"
awk '
/^[0-9a-f]/ { inh2 = ($0 ~ /h2|hammer2/); if (inh2) ncls++; next }
/^ -> / { if (inh2) from++; else if ($0 ~ /h2|hammer2/) into++ }
END { print "   " ncls " classes, " from " direct deps from them, " into " into them from other classes" }' /proc/lockdep
echo "== hammer2 class names, first 40 distinct prefixes"
grep -E "^[0-9a-f].*(h2|hammer2)" /proc/lockdep | sed "s/.*: //" | sed "s/\/[0-9]*$//" | sort | uniq -c | sort -rn | head -40 | sed "s/^/   /"
echo "== classes with most direct deps, top 12 (any owner)"
awk '/^[0-9a-f]/ { if (name != "") print n, name; name=$0; sub(/.*: /, "", name); n=0; next } /^ -> / { n++ } END { print n, name }' /proc/lockdep | sort -rn | head -12 | sed "s/^/   /"
umount /mnt/h2xscratch /mnt/h2xtest
dmesg | grep "after unmount" | tail -2 | sed "s/^/   /"
rmmod hammer2; echo "rmmod exit $?"
echo "== lockdep after rmmod"; ld
echo "debug_locks $(cat /proc/sys/kernel/debug_locks)"
echo "log: bug $(dmesg | grep -c "kernel BUG") oops $(dmesg | grep -ci oops) warn $(dmesg | grep -c "WARNING:") lockdep $(dmesg | grep -ci "lockdep\|possible.*deadlock\|too low")"
