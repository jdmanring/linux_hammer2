# Serena's symbol index, a local tool cache and not part of the port.
.serena/

# The code graph and its ignore list, the same: a local tool cache.
graphify-out/
.graphifyignore

# clangd's compilation database, emitted by kbuild's compile_commands.json
# target for Serena's language server, and clangd's index: both hold
# absolute paths into one machine's kernel tree.  Moved here from the
# module directory, where script/test-provenance.sh finds every file under
# src/ and correctly reports one with no origin.
/compile_commands.json
/.cache/
/.clangd

# Reverify's per-binary ledger, keyed by the hash of one build.
.reverify/

# Local editor and tool instructions and caches. Not part of the port.
CLAUDE.md
.claude/

# Local working notes. Not part of the port.
AGENT-HANDOFF.md
